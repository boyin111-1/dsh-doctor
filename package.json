{
  "name": "dsh-doctor",
  "version": "0.3.2",
  "description": "Pre-boot health check for DeepSeek Harness profiles: dangling refs, broken file: links, duplicate ids, dual @deepseek-ai instances, bundle integrity & id collisions, plus --fix relink.",
  "type": "module",
  "bin": {
    "dsh-doctor": "./dsh-doctor.mjs"
  },
  "scripts": {
    "test": "node test/destructive.test.mjs",
    "check": "node --check dsh-doctor.mjs && node test/destructive.test.mjs"
  },
  "files": [
    "dsh-doctor.mjs",
    "test/destructive.test.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "diagnostics",
    "plugin",
    "cordis",
    "healthcheck"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/boyin111-1/dsh-doctor.git"
  }
}
